# ==========================================
# Production Environment Configuration
# ==========================================

# Domain & ACME
DOMAIN=autoposter.example.com
ACME_EMAIL=ops@autoposter.example.com

# PostgreSQL
POSTGRES_USER=autoposter
POSTGRES_PASSWORD=replace_with_strong_database_password_32_chars
POSTGRES_DB=autoposter_prod
DATABASE_URL=postgresql://autoposter:replace_with_strong_database_password_32_chars@postgres:5432/autoposter_prod?schema=public&sslmode=prefer

# Redis
REDIS_PASSWORD=replace_with_strong_redis_password_32_chars
REDIS_URL=redis://:replace_with_strong_redis_password_32_chars@redis:6379

# Server & Security
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://autoposter.example.com
JWT_SECRET=replace_with_hex_or_base64_jwt_secret_minimum_32_chars
ENCRYPTION_KEY_32B=replace_with_32_character_aes_encryption_key!

# S3 / Cloud Storage (AWS / Cloudflare R2 / MinIO)
AWS_REGION=ap-south-1
S3_BUCKET=autoposter-prod-media
S3_ACCESS_KEY=your_production_s3_access_key
S3_SECRET_KEY=your_production_s3_secret_key
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# SMS Provider (Fast2SMS / Twilio)
FAST2SMS_API_KEY=your_fast2sms_api_key
SMS_SENDER_ID=APTPST

# Payment Provider (Razorpay / Cashfree)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

