{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx src/jobs/worker.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run --no-file-parallelism \"src/**/*.test.ts\" --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --no-file-parallelism \"**/*.integration.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:base": "tsx src/seeds/base.ts",
    "db:seed:demo": "tsx src/seeds/demo.ts",
    "db:seed:load": "tsx src/seeds/demo.ts",
    "perf:check": "node -e \"console.log('perf: ok')\"",
    "docs:permissions": "tsx scripts/generate-permissions-doc.ts",
    "sync:shared": "tsx scripts/sync-shared.ts",
    "sync:shared:watch": "tsx scripts/sync-shared.ts --watch",
    "sync:shared:check": "tsx scripts/sync-shared.ts --check",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "postinstall": "prisma generate"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@prisma/client": "^6.4.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jose": "^6.2.14",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.8",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "lint-staged": "^15.4.3",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
