NODE_ENV=development

# Database & Cache
DATABASE_URL=postgresql://autoposter:autoposter_local_secret@127.0.0.1:5432/autoposter_dev?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Server Configuration
PORT=4000
API_PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
WEB_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_DOMAIN=localhost

# Security Secrets (Must be 32+ characters or 64-char hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SECRET=autoposter_dev_hmac_secret_32_characters_long_min
JWT_ACCESS_SECRET=autoposter_jwt_access_secret_min_32_chars_long!
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_HMAC_SECRET=autoposter_otp_hmac_secret_min_32_chars_dev!
SMS_PROVIDER=dev
OTP_DEV_BYPASS_CODE=

# Object Storage (S3 / MinIO / R2)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=autoposter-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# Payment simulation
ENABLE_DEV_PAYMENT_SIMULATION=true
