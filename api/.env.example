# ==============================================================================
# 1. APPLICATION ENVIRONMENT & SERVER
# ==============================================================================
NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# 2. DATABASE CONFIGURATION (SUPABASE / POSTGRESQL)
# ==============================================================================
# Single Supabase / PostgreSQL database connection URL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public

# ==============================================================================
# 3. REDIS & BACKGROUND QUEUES (BULLMQ)
# ==============================================================================
REDIS_URL=redis://127.0.0.1:6380
REDIS_PORT=6380
REDIS_PASSWORD=

# ==============================================================================
# 4. SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
# AES-256-GCM 32-byte hex key for encrypting sensitive data (bank accounts, PAN)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 key for hashing session tokens & sensitive fingerprints
HMAC_SECRET=autoposter_dev_hmac_secret_32_characters_long_min

# JWT Access Token secret & lifetime
JWT_ACCESS_SECRET=autoposter_jwt_access_secret_min_32_chars_long!
JWT_ACCESS_TTL=15m

# Refresh Token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# ==============================================================================
# 5. OTP & SMS NOTIFICATIONS
# ==============================================================================
# SMS mode: 'dev' logs OTP to terminal, 'none' disables
SMS_PROVIDER=dev

# Development bypass code (allows instant login with 123456 in dev mode)
OTP_DEV_BYPASS_CODE=123456

# ==============================================================================
# 6. SMTP EMAIL SERVICE
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=notifications@autoposter.com

# ==============================================================================
# 7. OBJECT STORAGE (S3 / MINIO / CLOUDFLARE R2)
# ==============================================================================
# Storage for driver KYC docs, campaign artwork posters, and daily auto proof photos
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=autoposter-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# ==============================================================================
# 8. PAYMENT SIMULATION & DEV FLAGS
# ==============================================================================
ENABLE_DEV_PAYMENT_SIMULATION=true
