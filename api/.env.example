# ==============================================================================
# 1. APPLICATION ENVIRONMENT & SERVER
# ==============================================================================
NODE_ENV=development
# Database environment classification: 'development' or 'production' (Required)
DB_ENVIRONMENT=development
API_PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# 2. DATABASE CONFIGURATION (SUPABASE / POSTGRESQL)
# ==============================================================================
# Pooled database connection URL for runtime queries (e.g. Supabase port 6543 with pgbouncer)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public

# Direct connection URL used for migrations & DDL (e.g. Supabase port 5432)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public

# Test database connection URL (must target schema=test on the same host)
DATABASE_URL_TEST=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=test&connection_limit=5

# ==============================================================================
# 3. REDIS & BACKGROUND QUEUES (BULLMQ)
# ==============================================================================
# Redis connection URL (include password if needed: redis://:password@127.0.0.1:6380)
REDIS_URL=redis://127.0.0.1:6380

# ==============================================================================
# 4. SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
# AES-256-GCM 32-byte hex key for encrypting sensitive data (bank accounts, PAN)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 key for hashing OTP tokens & sensitive fingerprints (min 32 chars)
OTP_HMAC_SECRET=autoposter_dev_hmac_secret_32_characters_long_min
HMAC_SECRET=autoposter_dev_hmac_secret_32_characters_long_min

# JWT Access Token secret & lifetime
JWT_ACCESS_SECRET=autoposter_jwt_access_secret_min_32_chars_long!
JWT_ACCESS_TTL=15m

# Refresh Token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# ==============================================================================
# 5. OTP, SMS & PUSH NOTIFICATIONS
# ==============================================================================
# SMS mode: 'dev' logs OTP to terminal, 'none' disables
SMS_PROVIDER=dev

# Development bypass code (allows instant login with 123456 in dev mode)
OTP_DEV_BYPASS_CODE=123456

# Push notification provider: 'expo', 'dev', or 'none'
PUSH_PROVIDER=dev
EXPO_ACCESS_TOKEN=

# ==============================================================================
# 6. EMAIL SERVICE (SMTP)
# ==============================================================================
# Email provider: 'smtp', 'dev', or 'none'
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@autoposter.local

# ==============================================================================
# 7. OBJECT STORAGE (S3 / MINIO / SUPABASE STORAGE S3)
# ==============================================================================
# Development storage endpoint (MinIO or Supabase Storage S3-compatible endpoint)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=autoposter-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# ==============================================================================
# 8. PAYMENT SIMULATION & DEV FLAGS
# ==============================================================================
ENABLE_DEV_PAYMENT_SIMULATION=true
