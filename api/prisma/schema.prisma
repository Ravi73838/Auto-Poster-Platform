model Assignment {
  id                      String                  @id @default(uuid()) @db.Uuid
  campaignId              String                  @map("campaign_id") @db.Uuid
  driverId                String                  @map("driver_id") @db.Uuid
  vehicleId               String                  @map("vehicle_id") @db.Uuid
  status                  AssignmentStatus        @default(RESERVED)
  reservedAt              DateTime                @default(now()) @map("reserved_at")
  expiresAt               DateTime                @map("expires_at")
  installationDeadlineAt  DateTime?               @map("installation_deadline_at")
  installedAt             DateTime?               @map("installed_at")
  installApprovedAt       DateTime?               @map("install_approved_at")
  installApprovedByUserId String?                 @map("install_approved_by_user_id")
  installRejectReason     String?                 @map("install_reject_reason")
  startedAt               DateTime?               @map("started_at")
  endedAt                 DateTime?               @map("ended_at")
  totalDays               Int                     @map("total_days")
  windowDays              Int?                    @map("window_days")
  verifiedDays            Int                     @default(0) @map("verified_days")
  missedDays              Int                     @default(0) @map("missed_days")
  excusedDays             Int                     @default(0) @map("excused_days")
  rejectedDays            Int                     @default(0) @map("rejected_days")
  printingAllowancePaid   Boolean                 @default(false) @map("printing_allowance_paid")
  rentPaidPaise           BigInt                  @default(0) @map("rent_paid_paise")
  finalPayoutId           String?                 @map("final_payout_id") @db.Uuid
  releaseReason           AssignmentReleaseReason? @map("release_reason")
  releasedAt              DateTime?               @map("released_at")
  installAttempts         Int                     @default(0) @map("install_attempts")
  extraAttemptsGranted    Int                     @default(0) @map("extra_attempts_granted")
  reviewOwner             ReviewOwner             @default(PLATFORM) @map("review_owner")
  escalatedAt             DateTime?               @map("escalated_at")
  reviewClaimedById       String?                 @map("review_claimed_by_id") @db.Uuid
  reviewClaimedAt         DateTime?               @map("review_claimed_at")
  reservedIdempotencyKey  String?                 @unique @map("reserved_idempotency_key")
  forceManualReview       Boolean                 @default(false) @map("force_manual_review")
  terminatedById          String?                 @map("terminated_by_id") @db.Uuid
  terminationDate         DateTime?               @map("termination_date") @db.Date
  terminatedAt            DateTime?               @map("terminated_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  driver          User            @relation("DriverAssignments", fields: [driverId], references: [id], onDelete: Restrict)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  reviewClaimedBy User?           @relation("ReviewClaimedAssignments", fields: [reviewClaimedById], references: [id], onDelete: SetNull)
  terminatedBy    User?           @relation("TerminatedAssignments", fields: [terminatedById], references: [id], onDelete: SetNull)
  photos          Photo[]
  days            AssignmentDay[]
  strikes         Strike[]
  disputes        Dispute[]
  payouts         Payout[]
  settlement      AssignmentSettlement?
  posterFixNotices PosterFixNotice[]

  @@unique([campaignId, driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([reviewClaimedById])
  @@map("assignments")
}

model Photo {
  id                  String             @id @default(uuid()) @db.Uuid
  assignmentId        String             @map("assignment_id") @db.Uuid
  driverId            String             @map("driver_id") @db.Uuid
  kind                PhotoKind
  photoDate           DateTime?          @map("photo_date") @db.Date
  photoUrl            String             @map("photo_url")
  thumbnailUrl        String?            @map("thumbnail_url")
  lat                 Float
  lng                 Float
  accuracyMeters      Float              @map("accuracy_meters")
  capturedAt          DateTime           @map("captured_at")
  uploadedAt          DateTime           @default(now()) @map("uploaded_at")
  isInsideAllowedZone Boolean            @default(false) @map("is_inside_allowed_zone")
  distanceCoveredKm   Float              @default(0) @map("distance_covered_km")
  odometerReading     Float?             @map("odometer_reading")
  status              DailyPhotoStatus   @default(PENDING_CHECK)
  failureReason       String?            @map("failure_reason")
  reviewedByUserId    String?            @map("reviewed_by_user_id")
  reviewedAt          DateTime?          @map("reviewed_at")
  autoCheckFlags      Json?              @map("auto_check_flags")
  reviewReasonCodes   Json?              @map("review_reason_codes")
  duplicateFlags      Json?              @map("duplicate_flags")
  attemptNo           Int                @default(1) @map("attempt_no")
  dhash               String?            @db.VarChar(64)
  riskScore           Int                @default(0) @map("risk_score")
  reviewSource        PhotoReviewSource? @map("review_source")
  fileSha256          String?            @map("file_sha256") @db.VarChar(64)
  clientSentAt        DateTime?          @map("client_sent_at")
  reviewClaimedById   String?            @map("review_claimed_by_id") @db.Uuid
  reviewClaimedAt     DateTime?          @map("review_claimed_at")
  createdAt           DateTime           @default(now()) @map("created_at")

  assignment        Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  driver            User            @relation("DriverPhotos", fields: [driverId], references: [id], onDelete: Restrict)
  reviewClaimedBy   User?           @relation("ReviewClaimedPhotos", fields: [reviewClaimedById], references: [id], onDelete: SetNull)
  verifiedDays      AssignmentDay[] @relation("VerifiedPhotoDays")
  flags             PhotoFlag[]
  disputes          Dispute[]
  strikes           Strike[]
  posterFixSources  PosterFixNotice[] @relation("PosterFixSourcePhoto")
  posterFixResolved PosterFixNotice[] @relation("PosterFixResolvedPhoto")

  @@index([assignmentId])
  @@index([driverId])
  @@index([status])
  @@index([fileSha256])
  @@index([reviewClaimedById])
  @@index([riskScore])
  @@map("photos")
}

model AssignmentDay {
  id              String     @id @default(uuid()) @db.Uuid
  assignmentId    String     @map("assignment_id") @db.Uuid
  date            DateTime   @db.Date
  status          DayStatus  @default(PENDING)
  verifiedPhotoId String?    @map("verified_photo_id") @db.Uuid
  reasonCode      String?    @map("reason_code")
  excusedById     String?    @map("excused_by_id") @db.Uuid
  excuseNote      String?    @map("excuse_note")
  statusChangedAt DateTime?  @map("status_changed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  verifiedPhoto Photo?      @relation("VerifiedPhotoDays", fields: [verifiedPhotoId], references: [id], onDelete: SetNull)
  excusedBy     User?       @relation("ExcusedDays", fields: [excusedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, date])
