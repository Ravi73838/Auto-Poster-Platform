  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  driver    User     @relation("DriverBans", fields: [driverId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CreatedBans", fields: [createdById], references: [id], onDelete: SetNull)
  liftedBy  User?    @relation("LiftedBans", fields: [liftedById], references: [id], onDelete: SetNull)
  strikes   Strike[]

  @@index([driverId])
  @@index([type])
  @@index([endsAt])
  @@map("driver_bans")
}

model PosterFixNotice {
  id              String          @id @default(uuid()) @db.Uuid
  assignmentId    String          @map("assignment_id") @db.Uuid
  openedAt        DateTime        @default(now()) @map("opened_at")
  deadlineAt      DateTime        @map("deadline_at")
  status          PosterFixStatus @default(OPEN)
  sourcePhotoId   String?         @map("source_photo_id") @db.Uuid
  resolvedPhotoId String?         @map("resolved_photo_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sourcePhoto   Photo?     @relation("PosterFixSourcePhoto", fields: [sourcePhotoId], references: [id], onDelete: SetNull)
  resolvedPhoto Photo?     @relation("PosterFixResolvedPhoto", fields: [resolvedPhotoId], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([status])
  @@index([deadlineAt])
  @@map("poster_fix_notices")
}

model Dispute {
  id                      String                 @id @default(uuid()) @db.Uuid
  assignmentId            String?                @map("assignment_id") @db.Uuid
  campaignId              String?                @map("campaign_id") @db.Uuid
  photoId                 String?                @map("photo_id") @db.Uuid
  strikeId                String?                @map("strike_id") @db.Uuid
  settlementId            String?                @map("settlement_id") @db.Uuid
  disputedDate            DateTime?              @map("disputed_date") @db.Date
  raisedByUserId          String                 @map("raised_by_user_id") @db.Uuid
  role                    Role                   @default(DRIVER)
  raisedByRole            Role                   @default(DRIVER) @map("raised_by_role")
  againstParty            DisputeParty           @default(PLATFORM) @map("against_party")
  reason                  DisputeReason
  details                 String
  status                  DisputeStatus          @default(OPEN)
  claimedAmountPaise      BigInt?                @default(0) @map("claimed_amount_paise")
  heldAmountPaise         BigInt?                @default(0) @map("held_amount_paise")
  slaDueAt                DateTime?              @map("sla_due_at")
  assignedToId            String?                @map("assigned_to_id") @db.Uuid
  claimedAt               DateTime?              @map("claimed_at")
  escalatedAt             DateTime?              @map("escalated_at")
  reviewLevel             Int                    @default(1) @map("review_level")
  resolutionType          DisputeResolutionType? @map("resolution_type")
  resolution              String?
  resolutionToDriverPaise BigInt?                @default(0) @map("resolution_to_driver_paise")
  resolutionToCompanyPaise BigInt?               @default(0) @map("resolution_to_company_paise")
  resolvedByUserId        String?                @map("resolved_by_user_id")
  resolvedAt              DateTime?              @map("resolved_at")
  closedAt                DateTime?              @map("closed_at")
  reopenRequestedAt       DateTime?              @map("reopen_requested_at")
  reopenRequestedById     String?                @map("reopen_requested_by_id") @db.Uuid
  queue                   DisputeQueue           @default(MODERATION)
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  assignment        Assignment?           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  campaign          Campaign?             @relation("CampaignDisputes", fields: [campaignId], references: [id], onDelete: SetNull)
  photo             Photo?                @relation(fields: [photoId], references: [id], onDelete: SetNull)
  strike            Strike?               @relation(fields: [strikeId], references: [id], onDelete: SetNull)
  settlement        AssignmentSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  raisedByUser      User                  @relation("DisputesRaised", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  assignedTo        User?                 @relation("AssignedDisputes", fields: [assignedToId], references: [id], onDelete: SetNull)
  reopenRequestedBy User?                 @relation("ReopenRequestedDisputes", fields: [reopenRequestedById], references: [id], onDelete: SetNull)
  evidences         DisputeEvidence[]
  messages          DisputeMessage[]
  events            DisputeEvent[]

  @@index([assignmentId])
  @@index([campaignId])
  @@index([status])
  @@index([queue])
  @@index([assignedToId])
  @@index([slaDueAt])
  @@map("disputes")
}

model DisputeMessage {
  id         String                   @id @default(uuid()) @db.Uuid
  disputeId  String                   @map("dispute_id") @db.Uuid
  authorId   String                   @map("author_id") @db.Uuid
  authorRole Role                     @map("author_role")
  body       String
  visibleTo  DisputeMessageVisibility @default(BOTH) @map("visible_to")
  createdAt  DateTime                 @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation("DisputeMessages", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@map("dispute_messages")
}

model DisputeEvent {
  id        String   @id @default(uuid()) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  type      String
  actorId   String?  @map("actor_id") @db.Uuid
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor   User?   @relation("DisputeEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([disputeId])
  @@map("dispute_events")
}

model DisputeEvidence {
  id                   String   @id @default(uuid()) @db.Uuid
  disputeId            String   @map("dispute_id") @db.Uuid
  uploadedByUserId     String   @map("uploaded_by_user_id") @db.Uuid
  fileUrl              String   @map("file_url")
  notes                String?
  visibleToOtherParty  Boolean  @default(false) @map("visible_to_other_party")
  createdAt            DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_evidences")
}

