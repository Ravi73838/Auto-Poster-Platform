// FINANCIAL LEDGER (DOUBLE-ENTRY, APPEND-ONLY)
// ---------------------------------------------------------

model LedgerAccount {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  accountType LedgerAccountType @map("account_type")
  currency    String            @default("INR")
  userId      String?           @map("user_id") @db.Uuid
  campaignId  String?           @map("campaign_id") @db.Uuid
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user        User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]
  adjustments Adjustment[]

  @@index([accountType])
  @@index([userId])
  @@index([campaignId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String        @id @default(uuid()) @db.Uuid
  refType        LedgerRefType @map("ref_type")
  refId          String        @map("ref_id")
  description    String
  idempotencyKey String?       @unique @map("idempotency_key")
  metadata       Json?
  postedAt       DateTime      @default(now()) @map("posted_at")

  entries LedgerEntry[]

  @@index([refType, refId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  transactionId     String          @map("transaction_id") @db.Uuid
  accountId         String          @map("account_id") @db.Uuid
  direction         LedgerDirection
  amountPaise       BigInt          @map("amount_paise")
  balanceAfterPaise BigInt          @map("balance_after_paise")
  createdAt         DateTime        @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

model Payout {
  id                   String             @id @default(uuid()) @db.Uuid
  driverId             String             @map("driver_id") @db.Uuid
  assignmentId         String?            @map("assignment_id") @db.Uuid
  payoutType           PayoutType         @map("payout_type")
  amountPaise          BigInt             @map("amount_paise")
  method               PayoutMethod       @default(UPI)
  upiIdEncrypted       String?            @map("upi_id_encrypted")
  bankAccountEncrypted String?            @map("bank_account_encrypted")
  status               PayoutStatus       @default(PENDING)
  gatewayReference     String?            @map("gateway_reference")
  failureReason        String?            @map("failure_reason")
  batchId              String?            @map("batch_id") @db.Uuid
  utr                  String?
  requestedById        String?            @map("requested_by_id") @db.Uuid
  idempotencyKey       String?            @unique @map("idempotency_key")
  expectedByDate       DateTime?          @map("expected_by_date") @db.Date
  provider             PayoutProviderName @default(DEV)
  requestedAt          DateTime           @default(now()) @map("requested_at")
  approvedAt           DateTime?          @map("approved_at")
  approvedByUserId     String?            @map("approved_by_user_id")
  processedAt          DateTime?          @map("processed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  driver      User         @relation("DriverPayouts", fields: [driverId], references: [id], onDelete: Restrict)
  assignment  Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  batch       PayoutBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  requestedBy User?        @relation("RequestedPayouts", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([status])
  @@index([batchId])
  @@map("payouts")
}

model Refund {
  id              String        @id @default(uuid()) @db.Uuid
  campaignId      String        @map("campaign_id") @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  paymentId       String?       @map("payment_id") @db.Uuid
  amountPaise     BigInt        @map("amount_paise")
  reason          RefundReason
  status          RefundStatus  @default(PENDING)
  notes           String?
  requestedById   String        @map("requested_by_id") @db.Uuid
  approvedById    String?       @map("approved_by_id") @db.Uuid
  rejectedById    String?       @map("rejected_by_id") @db.Uuid
  rejectionReason String?       @map("rejection_reason")
  gatewayRefundId String?       @map("gateway_refund_id")
  idempotencyKey  String?       @unique @map("idempotency_key")
  creditNoteId    String?       @map("credit_note_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  company     User             @relation("CompanyRefunds", fields: [companyId], references: [id], onDelete: Restrict)
  payment     CampaignPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  requestedBy User             @relation("RequestedRefunds", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?            @relation("ApprovedRefunds", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User?            @relation("RejectedRefunds", fields: [rejectedById], references: [id], onDelete: SetNull)
  creditNote  TaxDocument?     @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([companyId])
  @@index([status])
  @@map("refunds")
}

model AssignmentSettlement {
  id                     String           @id @default(uuid()) @db.Uuid
  assignmentId           String           @unique @map("assignment_id") @db.Uuid
  campaignId             String           @map("campaign_id") @db.Uuid
  driverId               String           @map("driver_id") @db.Uuid
  status                 SettlementStatus @default(PENDING)
  totalDays              Int              @map("total_days")
  verifiedDays           Int              @map("verified_days")
  missedDays             Int              @map("missed_days")
  graceDaysUsed          Int              @map("grace_days_used")
  payableDays            Int              @map("payable_days")
  dailyRentPaise         BigInt           @map("daily_rent_paise")
  rentPayablePaise       BigInt           @map("rent_payable_paise")
  printingAllowancePaise BigInt           @map("printing_allowance_paise")
  companyRefundPaise     BigInt           @map("company_refund_paise")
  commissionPaise        BigInt           @map("commission_paise")
  gstPaise               BigInt           @map("gst_paise")
  totalAmountPaise       BigInt           @map("total_amount_paise")
  anomalyFlags           Json?            @map("anomaly_flags")
  holdReason             String?          @map("hold_reason")
  approvedById           String?          @map("approved_by_id") @db.Uuid
  approvedAt             DateTime?        @map("approved_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  driver     User       @relation("DriverSettlements", fields: [driverId], references: [id], onDelete: Restrict)
  approvedBy User?      @relation("ApprovedSettlements", fields: [approvedById], references: [id], onDelete: SetNull)
  disputes   Dispute[]

  @@index([campaignId])
  @@index([driverId])
  @@index([status])
  @@map("assignment_settlements")
}

model TaxDocument {
  id                 String          @id @default(uuid()) @db.Uuid
  documentType       TaxDocumentType @map("document_type")
  documentNumber     String          @unique @map("document_number")
  financialYear      String          @map("financial_year")
  sequenceNumber     Int             @map("sequence_number")
  campaignId         String          @map("campaign_id") @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  paymentId          String?         @map("payment_id") @db.Uuid
  taxableAmountPaise BigInt          @map("taxable_amount_paise")
  cgstPaise          BigInt          @default(0) @map("cgst_paise")
  sgstPaise          BigInt          @default(0) @map("sgst_paise")
  igstPaise          BigInt          @default(0) @map("igst_paise")
  totalAmountPaise   BigInt          @map("total_amount_paise")
  pdfUrl             String?         @map("pdf_url")
  metadata           Json?
  issuedAt           DateTime        @default(now()) @map("issued_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  company  User             @relation("CompanyTaxDocuments", fields: [companyId], references: [id], onDelete: Restrict)
  payment  CampaignPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refunds  Refund[]

  @@index([campaignId])
  @@index([companyId])
  @@index([documentType, financialYear])
  @@map("tax_documents")
}

model InvoiceCounter {
  id            String          @id @default(uuid()) @db.Uuid
  financialYear String          @map("financial_year")
  documentType  TaxDocumentType @map("document_type")
  lastNumber    Int             @default(0) @map("last_number")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([financialYear, documentType])
  @@map("invoice_counters")
}

model Adjustment {
  id              String           @id @default(uuid()) @db.Uuid
  accountId       String           @map("account_id") @db.Uuid
  amountPaise     BigInt           @map("amount_paise")
  direction       LedgerDirection
  reason          String
  status          AdjustmentStatus @default(PENDING)
  requestedById   String           @map("requested_by_id") @db.Uuid
  approvedById    String?          @map("approved_by_id") @db.Uuid
  rejectedById    String?          @map("rejected_by_id") @db.Uuid
  rejectionReason String?          @map("rejection_reason")
  transactionId   String?          @map("transaction_id") @db.Uuid
  idempotencyKey  String?          @unique @map("idempotency_key")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  requestedBy User          @relation("RequestedAdjustments", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?         @relation("ApprovedAdjustments", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User?         @relation("RejectedAdjustments", fields: [rejectedById], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([status])
  @@map("adjustments")
}

model PayoutBatch {
  id               String             @id @default(uuid()) @db.Uuid
  batchNumber      String             @unique @map("batch_number")
  provider         PayoutProviderName
  totalCount       Int                @default(0) @map("total_count")
  totalAmountPaise BigInt             @default(0) @map("total_amount_paise")
  status           String             @default("CREATED")
  csvFileUrl       String?            @map("csv_file_url")
  processedAt      DateTime?          @map("processed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  payouts Payout[]

  @@map("payout_batches")
}

model ReconciliationRun {
  id                    String   @id @default(uuid()) @db.Uuid
  runDate               DateTime @db.Date @map("run_date")
  status                String
  trialBalanceDiffPaise BigInt   @default(0) @map("trial_balance_diff_paise")
  anomaliesFound        Int      @default(0) @map("anomalies_found")
  details               Json?
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([runDate])
  @@map("reconciliation_runs")
}

// ---------------------------------------------------------
// SYSTEM & AUDIT
// ---------------------------------------------------------

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory @default(SYSTEM)
  channel   NotificationChannel
  priority  NotificationPriority @default(NORMAL)
  title     String
  body      String
  data      Json?
  groupKey  String?              @map("group_key")
  status    NotificationStatus   @default(PENDING)
  error     String?
  sentAt    DateTime?            @map("sent_at")
  readAt    DateTime?            @map("read_at")
  dedupeKey String?              @unique @map("dedupe_key")
  createdAt DateTime             @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  user User @relation("NotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@index([userId])
  @@map("notification_preferences")
}

model UserNotificationSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  quietHoursStart String   @default("22:00") @map("quiet_hours_start")
  quietHoursEnd   String   @default("07:00") @map("quiet_hours_end")
  language        String?  @default("en")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  notificationId    String              @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  provider          String?
  providerMessageId String?             @map("provider_message_id")
  attempts          Int                 @default(0)
  error             String?
  scheduledFor      DateTime?           @map("scheduled_for")
  sentAt            DateTime?           @map("sent_at")
  deviceTokenId     String?             @map("device_token_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceToken  DeviceToken? @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([status])
  @@index([scheduledFor])
  @@map("notification_deliveries")
}

model Announcement {
  id              String             @id @default(uuid()) @db.Uuid
  createdById     String             @map("created_by_id") @db.Uuid
  titleByLanguage Json               @map("title_by_language")
  bodyByLanguage  Json               @map("body_by_language")
  audience        Json
  scheduledFor    DateTime?          @map("scheduled_for")
  status          AnnouncementStatus @default(DRAFT)
  counts          Json?              @default("{\"target\":0,\"sent\":0,\"failed\":0}")
  sentAt          DateTime?          @map("sent_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  createdBy User @relation("CreatedAnnouncements", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("announcements")
}

model Setting {
  key             String   @id
  value           Json
  description     String?
  updatedByUserId String?  @map("updated_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  oldValues  Json?     @map("old_values")
  newValues  Json?     @map("new_values")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  actor User? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// PHASE 10: ADMIN PORTAL MODELS
// ---------------------------------------------------------

model DailyMetric {
  id         String   @id @default(uuid()) @db.Uuid
  date       DateTime @db.Date
  cityId     String?  @map("city_id") @db.Uuid
  metrics    Json
  computedAt DateTime @default(now()) @map("computed_at")

  city City? @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([date, cityId])
  @@index([date])
  @@map("daily_metrics")
}

model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  pageKey   String   @map("page_key")
  name      String
  filters   Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pageKey])
  @@map("saved_views")
}

model ExportJob {
  id            String          @id @default(uuid()) @db.Uuid
  requestedById String          @map("requested_by_id") @db.Uuid
  reportKey     String          @map("report_key")
  filters       Json
  status        ExportJobStatus @default(QUEUED)
  rowCount      Int             @default(0) @map("row_count")
  fileKey       String?         @map("file_key")
  expiresAt     DateTime?       @map("expires_at")
  error         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  requestedBy User @relation("RequestedExportJobs", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requestedById])
  @@map("export_jobs")
}

model SettingChangeRequest {
  id            String                     @id @default(uuid()) @db.Uuid
  key           String
  oldValue      Json?                      @map("old_value")
  newValue      Json                       @map("new_value")
  reason        String
  requestedById String                     @map("requested_by_id") @db.Uuid
  approvedById  String?                    @map("approved_by_id") @db.Uuid
  status        SettingChangeRequestStatus @default(REQUESTED)
  appliedAt     DateTime?                  @map("applied_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  requestedBy User  @relation("RequestedSettingChanges", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("ApprovedSettingChanges", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([status])
  @@map("setting_change_requests")
}

model LegalDocument {
  id           String              @id @default(uuid()) @db.Uuid
  type         LegalDocumentType
  language     String              @default("en")
  version      Int
  title        String
  bodyMarkdown String              @map("body_markdown") @db.Text
  status       LegalDocumentStatus @default(DRAFT)
  publishedAt  DateTime?           @map("published_at")
  createdById  String              @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  createdBy User @relation("CreatedLegalDocuments", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([type, language, version])
  @@index([type, status])
  @@map("legal_documents")
}

model HelpArticle {
  id           String   @id @default(uuid()) @db.Uuid
  category     String
  language     String   @default("en")
  title        String
  bodyMarkdown String   @map("body_markdown") @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  published    Boolean  @default(true)
  updatedById  String   @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  updatedBy User @relation("UpdatedHelpArticles", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([category, language, published])
  @@map("help_articles")
}

model JobRun {
  id         String       @id @default(uuid()) @db.Uuid
  jobName    String       @map("job_name")
  startedAt  DateTime     @default(now()) @map("started_at")
  finishedAt DateTime?    @map("finished_at")
  status     JobRunStatus @default(SUCCESS)
  counts     Json?
  error      String?      @db.Text

  @@index([jobName, startedAt])
  @@index([status])
  @@map("job_runs")
}
