  resolutionNote String?         @map("resolution_note")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  photo       Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  flaggedBy   User  @relation("UserFlaggedPhotos", fields: [flaggedById], references: [id], onDelete: Restrict)
  resolvedBy  User? @relation("UserResolvedPhotoFlags", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([photoId, status])
  @@index([flaggedById])
  @@map("photo_flags")
}

model Strike {
  id             String       @id @default(uuid()) @db.Uuid
  driverId       String       @map("driver_id") @db.Uuid
  assignmentId   String?      @map("assignment_id") @db.Uuid
  reason         StrikeReason
  status         StrikeStatus @default(ACTIVE)
  source         StrikeSource @default(AUTO_RULE)
  notes          String?
  issuedByUserId String?      @map("issued_by_user_id") @db.Uuid
  issuedAt       DateTime     @default(now()) @map("issued_at")
  expiresAt      DateTime     @map("expires_at")
  revokedById    String?      @map("revoked_by_id") @db.Uuid
  revokedAt      DateTime?    @map("revoked_at")
  revokeReason   String?      @map("revoke_reason")
  banId          String?      @map("ban_id") @db.Uuid
  photoId        String?      @map("photo_id") @db.Uuid
  dayDate        DateTime?    @map("day_date") @db.Date
  dedupeKey      String?      @unique @map("dedupe_key")

  driver     User        @relation("DriverStrikes", fields: [driverId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  revokedBy  User?       @relation("RevokedStrikes", fields: [revokedById], references: [id], onDelete: SetNull)
  ban        DriverBan?  @relation(fields: [banId], references: [id], onDelete: SetNull)
  photo      Photo?      @relation(fields: [photoId], references: [id], onDelete: SetNull)
  disputes   Dispute[]

  @@index([driverId])
  @@index([status])
  @@index([expiresAt])
  @@map("strikes")
}

model DriverBan {
  id          String    @id @default(uuid()) @db.Uuid
  driverId    String    @map("driver_id") @db.Uuid
  type        BanType
  startsAt    DateTime  @default(now()) @map("starts_at")
  endsAt      DateTime? @map("ends_at")
