// ---------------------------------------------------------
// LOCATION
// ---------------------------------------------------------

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  state     String
  country   String   @default("IN")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zones           Zone[]
  driverProfiles  DriverProfile[]
  companyProfiles CompanyProfile[]
  campaigns       Campaign[]
  dailyMetrics    DailyMetric[]


  @@unique([name, state])
  @@map("cities")
}

model Zone {
  id              String   @id @default(uuid()) @db.Uuid
  cityId          String   @map("city_id") @db.Uuid
  name            String
  pinCodes        String[] @default([]) @map("pin_codes")
  centerLat       Float    @map("center_lat")
  centerLng       Float    @map("center_lng")
  radiusMeters    Float    @map("radius_meters")
  boundaryGeoJson Json?    @map("boundary_geojson")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  driverZones   DriverZone[]
  campaignZones CampaignZone[]

  @@index([cityId])
  @@map("zones")
}

// ---------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------

model User {
  id                String        @id @default(uuid()) @db.Uuid
  role              Role
  mobile            String        @unique
  email             String?       @unique
  passwordHash      String?       @map("password_hash")
  status            AccountStatus @default(PENDING)
  preferredLanguage String        @default("en") @map("preferred_language")
  preferredTheme    String        @default("system") @map("preferred_theme")
  twoFactorEnabled   Boolean       @default(false) @map("two_factor_enabled")
  mobileVerifiedAt   DateTime?     @map("mobile_verified_at")
  emailVerifiedAt    DateTime?     @map("email_verified_at")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?     @map("password_changed_at")
  lastLoginAt        DateTime?     @map("last_login_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  sessions         Session[]
  deviceTokens     DeviceToken[]
  driverProfile    DriverProfile?
  companyProfile   CompanyProfile?
  documents        Document[]        @relation("UserDocuments")
  campaigns        Campaign[]        @relation("CompanyCampaigns")
  campaignPayments CampaignPayment[]
  assignments      Assignment[]      @relation("DriverAssignments")
  photos           Photo[]           @relation("DriverPhotos")
  strikes          Strike[]          @relation("DriverStrikes")
  disputesRaised   Dispute[]         @relation("DisputesRaised")
  ledgerAccounts   LedgerAccount[]
  payouts          Payout[]          @relation("DriverPayouts")
  notifications    Notification[]
  auditLogs        AuditLog[]        @relation("UserAuditLogs")
  uploadedFiles          UploadedFile[]    @relation("UserUploadedFiles")
  consentRecords         ConsentRecord[]
  kycSubmissions         KycSubmission[]   @relation("UserKycSubmissions")
  assignedKycSubmissions KycSubmission[]   @relation("AssignedKycSubmissions")
  reviewedKycSubmissions KycSubmission[]   @relation("ReviewedKycSubmissions")
  assignedCampaigns      Campaign[]        @relation("CampaignReviewer")
  campaignReviews        CampaignReview[]  @relation("ReviewerCampaignReviews")
  claimedAssignments    Assignment[]      @relation("ReviewClaimedAssignments")
  reviewClaimedPhotos    Photo[]           @relation("ReviewClaimedPhotos")
  excusedDays            AssignmentDay[]   @relation("ExcusedDays")
  flaggedPhotos          PhotoFlag[]       @relation("UserFlaggedPhotos")
  resolvedPhotoFlags     PhotoFlag[]       @relation("UserResolvedPhotoFlags")
  companyRefunds         Refund[]          @relation("CompanyRefunds")
  requestedRefunds       Refund[]          @relation("RequestedRefunds")
  approvedRefunds        Refund[]          @relation("ApprovedRefunds")
  rejectedRefunds        Refund[]          @relation("RejectedRefunds")
  driverSettlements      AssignmentSettlement[] @relation("DriverSettlements")
  approvedSettlements    AssignmentSettlement[] @relation("ApprovedSettlements")
  companyTaxDocuments    TaxDocument[]     @relation("CompanyTaxDocuments")
  requestedPayouts       Payout[]          @relation("RequestedPayouts")
  requestedAdjustments   Adjustment[]      @relation("RequestedAdjustments")
  approvedAdjustments    Adjustment[]      @relation("ApprovedAdjustments")
  rejectedAdjustments    Adjustment[]      @relation("RejectedAdjustments")
  revokedStrikes         Strike[]          @relation("RevokedStrikes")
  bans                   DriverBan[]       @relation("DriverBans")
  createdBans            DriverBan[]       @relation("CreatedBans")
  liftedBans             DriverBan[]       @relation("LiftedBans")
  terminatedAssignments  Assignment[]      @relation("TerminatedAssignments")
  assignedDisputes       Dispute[]         @relation("AssignedDisputes")
  reopenRequestedDisputes Dispute[]        @relation("ReopenRequestedDisputes")
  disputeMessages        DisputeMessage[]  @relation("DisputeMessages")
  disputeEvents          DisputeEvent[]    @relation("DisputeEvents")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferences")
  notificationSettings   UserNotificationSettings?
  createdAnnouncements   Announcement[]    @relation("CreatedAnnouncements")
  savedViews             SavedView[]
  exportJobs             ExportJob[]               @relation("RequestedExportJobs")
  settingChangeRequestsRequested SettingChangeRequest[] @relation("RequestedSettingChanges")
  settingChangeRequestsApproved  SettingChangeRequest[] @relation("ApprovedSettingChanges")
  legalDocumentsCreated  LegalDocument[]           @relation("CreatedLegalDocuments")
  helpArticlesUpdated    HelpArticle[]             @relation("UpdatedHelpArticles")

  @@map("users")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  role         Role
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model Session {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  tokenHash         String         @unique @map("token_hash")
  previousTokenHash String?        @map("previous_token_hash")
  platform          DevicePlatform @default(WEB)
  userAgent         String?        @map("user_agent")
  ipAddress         String?        @map("ip_address")
  appVersion        String?        @map("app_version")
  expiresAt         DateTime       @map("expires_at")
  lastUsedAt        DateTime       @default(now()) @map("last_used_at")
  revokedAt         DateTime?      @map("revoked_at")
  stepUpVerifiedAt  DateTime?      @map("step_up_verified_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([previousTokenHash])
  @@map("sessions")
}

model OtpRequest {
  id          String     @id @default(uuid()) @db.Uuid
  mobile      String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(3) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([mobile, purpose])
  @@map("otp_requests")
}

model DeviceToken {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  token            String
  platform         DevicePlatform
  provider         DevicePushProvider @default(EXPO)
  appVersion       String?            @map("app_version")
  disabledAt       DateTime?          @map("disabled_at")
  lastRegisteredAt DateTime           @default(now()) @map("last_registered_at")
  lastSeenAt       DateTime           @default(now()) @map("last_seen_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, token])
  @@index([token])
  @@map("device_tokens")
}

// ---------------------------------------------------------
// PROFILES & ASSETS
// ---------------------------------------------------------

model Vehicle {
  id                 String      @id @default(uuid()) @db.Uuid
  registrationNumber String      @unique @map("registration_number")
  vehicleType        VehicleType @default(AUTO_RICKSHAW) @map("vehicle_type")
  ownerName          String?     @map("owner_name")
  ownerMobile        String?     @map("owner_mobile")
  rcNumber           String?     @map("rc_number")
  insuranceExpiry    DateTime?   @map("insurance_expiry")
  permitExpiry       DateTime?   @map("permit_expiry")
  fitnessExpiry      DateTime?   @map("fitness_expiry")
  isVerified         Boolean     @default(false) @map("is_verified")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  driverProfiles DriverProfile[]
  documents      Document[]
  assignments    Assignment[]

  @@map("vehicles")
}

model DriverProfile {
  id                         String       @id @default(uuid()) @db.Uuid
  userId                     String       @unique @map("user_id") @db.Uuid
  fullName                   String?      @map("full_name")
  cityId                     String?      @map("city_id") @db.Uuid
  currentVehicleId           String?      @map("current_vehicle_id") @db.Uuid
  upiIdEncrypted             String?      @map("upi_id_encrypted")
  upiIdMasked                String?      @map("upi_id_masked")
  bankAccountNumberEncrypted String?      @map("bank_account_number_encrypted")
  bankAccountFingerprint     String?      @map("bank_account_fingerprint") @db.VarChar(64)
  bankIfsc                   String?      @map("bank_ifsc")
  bankAccountName            String?      @map("bank_account_name")
  payoutMethod               PayoutMethod @default(UPI) @map("payout_method")
  payoutDetailsChangedAt     DateTime?    @map("payout_details_changed_at")
  isAvailable                Boolean      @default(true) @map("is_available")
  lifetimeEarningsPaise      BigInt       @default(0) @map("lifetime_earnings_paise")
  completedCampaignsCount    Int          @default(0) @map("completed_campaigns_count")
  totalKmDriven              Float        @default(0) @map("total_km_driven")
  rating                     Float        @default(5.0)
  strikesCount               Int          @default(0) @map("strikes_count")
  bannedUntil                DateTime?    @map("banned_until")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  city           City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)
  currentVehicle Vehicle?     @relation(fields: [currentVehicleId], references: [id], onDelete: SetNull)
  driverZones    DriverZone[]

  @@index([cityId])
  @@index([bankAccountFingerprint])
  @@map("driver_profiles")
}

model DriverZone {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  zone   Zone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([driverId, zoneId])
  @@map("driver_zones")
}

model CompanyProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  cityId             String?  @map("city_id") @db.Uuid
  companyName        String   @map("company_name")
  brandName          String?  @map("brand_name")
  legalName          String?  @map("legal_name")
  gstin              String?  @unique
  pan                String?
  billingAddress     Json?    @map("billing_address")
  website            String?
  contactPersonName  String   @map("contact_person_name")
  contactPersonPhone String   @map("contact_person_phone")
  isVerified         Boolean  @default(false) @map("is_verified")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([cityId])
  @@map("company_profiles")
}

model Document {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  vehicleId        String?        @map("vehicle_id") @db.Uuid
  uploadedFileId   String?        @map("uploaded_file_id") @db.Uuid
  documentType     DocumentType   @map("document_type")
  fileUrl          String?        @map("file_url")
  mimeType         String         @map("mime_type")
  fileSizeBytes    Int            @map("file_size_bytes")
  status           DocumentStatus @default(PENDING)
  rejectionReason  String?        @map("rejection_reason")
  rejectReasonCode KycReasonCode? @map("reject_reason_code")
  isCurrent        Boolean        @default(true) @map("is_current")
  verifiedAt       DateTime?      @map("verified_at")
  verifiedByUserId String?        @map("verified_by_user_id")
  expiresAt        DateTime?      @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user         User          @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  uploadedFile UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([vehicleId])
  @@index([uploadedFileId])
  @@index([userId, documentType, isCurrent])
  @@map("documents")
}

model UploadedFile {
  id          String      @id @default(uuid()) @db.Uuid
  ownerUserId String      @map("owner_user_id") @db.Uuid
  fileKey     String      @unique @map("file_key")
  purpose     FilePurpose
  mimeType    String      @map("mime_type")
  sizeBytes   Int         @map("size_bytes")
  status      FileStatus  @default(PENDING)
  sha256       String?     @db.VarChar(64)
  width        Int?
  height       Int?
  thumbnailKey String?     @map("thumbnail_key")
  previewKey   String?     @map("preview_key")
  createdAt    DateTime    @default(now()) @map("created_at")
  confirmedAt  DateTime?   @map("confirmed_at")

  ownerUser User       @relation("UserUploadedFiles", fields: [ownerUserId], references: [id], onDelete: Cascade)
  documents Document[]
  campaigns Campaign[] @relation("CampaignPosterFile")


  @@index([ownerUserId])
  @@index([status])
  @@map("uploaded_files")
}

model ConsentRecord {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @map("accepted_at")
  ip         String
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
  @@index([userId])
  @@map("consent_records")
}

model KycSubmission {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  attemptNo       Int                 @default(1) @map("attempt_no")
  status          KycSubmissionStatus @default(SUBMITTED)
  submittedAt     DateTime            @default(now()) @map("submitted_at")
  assignedToId    String?             @map("assigned_to_id") @db.Uuid
  assignedAt      DateTime?           @map("assigned_at")
  reviewedById    String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?           @map("reviewed_at")
  decisionNote    String?             @map("decision_note")
  reviewReasons   Json?               @map("review_reasons")
  profileSnapshot Json                @map("profile_snapshot")
  duplicateFlags  Json?               @map("duplicate_flags")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user       User  @relation("UserKycSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedKycSubmissions", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ReviewedKycSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([assignedToId, status])
  @@index([userId])
  @@map("kyc_submissions")
}

// ---------------------------------------------------------
// CAMPAIGNS & DISTRIBUTION
// ---------------------------------------------------------

model Campaign {
  id                     String          @id @default(uuid()) @db.Uuid
  companyId              String          @map("company_id") @db.Uuid
  title                  String
  description            String?
  creativeUrl            String?         @map("creative_url")
  creativeThumbnailUrl   String?         @map("creative_thumbnail_url")
  printInstructions      String?         @map("print_instructions")
  targetVehicleType      VehicleType     @default(AUTO_RICKSHAW) @map("target_vehicle_type")
  targetAutoCount        Int             @map("target_auto_count")
  enrolledCount          Int             @default(0) @map("enrolled_count")
  startDate              DateTime        @map("start_date")
  endDate                DateTime        @map("end_date")
  dailyRentPaise         Int             @map("daily_rent_paise")
  printingAllowancePaise Int             @map("printing_allowance_paise")
  totalBudgetPaise       BigInt          @map("total_budget_paise")
  platformFeePaise       BigInt          @map("platform_fee_paise")
  gstAmountPaise         BigInt          @map("gst_amount_paise")
  totalChargedPaise      BigInt          @map("total_charged_paise")
  status                 CampaignStatus  @default(DRAFT)
  installApprover        InstallApprover @default(PLATFORM) @map("install_approver")
  minDailyKm             Int             @default(30) @map("min_daily_km")
  dailyPhotoStartHour    Int             @default(6) @map("daily_photo_start_hour")
  dailyPhotoEndHour      Int             @default(22) @map("daily_photo_end_hour")
  termsAcceptedAt        DateTime?       @map("terms_accepted_at")
  approvedAt             DateTime?       @map("approved_at")
  approvedByUserId       String?         @map("approved_by_user_id")
  cancelledAt            DateTime?       @map("cancelled_at")
  cancellationReason     String?         @map("cancellation_reason")
  deletedAt              DateTime?       @map("deleted_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  // Phase 5 additions
  cityId                 String?         @map("city_id") @db.Uuid
  posterFileId           String?         @map("poster_file_id") @db.Uuid
  printMaterial          PrintMaterial   @default(VINYL_STICKER) @map("print_material")
  printSize              String?         @map("print_size")
  enrolmentClosesAt      DateTime?       @map("enrolment_closes_at")
  paymentDeadlineAt      DateTime?       @map("payment_deadline_at")
  liveAt                 DateTime?       @map("live_at")
  commissionBps          Int?            @map("commission_bps")
  gstBps                 Int?            @map("gst_bps")
  assignedToId           String?         @map("assigned_to_id") @db.Uuid
  assignedAt             DateTime?       @map("assigned_at")
  pricingSnapshot        Json?           @map("pricing_snapshot")
  revisionCount          Int             @default(0) @map("revision_count")
  reviewReasons          Json?           @map("review_reasons")
  lastSubmittedAt        DateTime?       @map("last_submitted_at")

  company        User              @relation("CompanyCampaigns", fields: [companyId], references: [id], onDelete: Restrict)
  city           City?             @relation(fields: [cityId], references: [id])
  posterFile     UploadedFile?     @relation("CampaignPosterFile", fields: [posterFileId], references: [id])
  assignedTo     User?             @relation("CampaignReviewer", fields: [assignedToId], references: [id])
  reviews        CampaignReview[]
  campaignZones  CampaignZone[]
  payments       CampaignPayment[]
  assignments    Assignment[]
  ledgerAccounts LedgerAccount[]
  refunds        Refund[]
  settlements    AssignmentSettlement[]
  taxDocuments   TaxDocument[]
  disputes       Dispute[]         @relation("CampaignDisputes")

  @@index([companyId])
  @@index([status])
  @@index([cityId])
  @@index([assignedToId])
  @@map("campaigns")
}

model CampaignReview {
  id         String                 @id @default(uuid()) @db.Uuid
  campaignId String                 @map("campaign_id") @db.Uuid
  attemptNo  Int                    @map("attempt_no")
  reviewerId String                 @map("reviewer_id") @db.Uuid
  decision   CampaignReviewDecision
  reasons    Json?
  note       String?
  createdAt  DateTime               @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reviewer User     @relation("ReviewerCampaignReviews", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([reviewerId])
  @@map("campaign_reviews")
}


model CampaignZone {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  zone     Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([campaignId, zoneId])
  @@map("campaign_zones")
}

model CampaignPayment {
  id                  String        @id @default(uuid()) @db.Uuid
  campaignId          String        @map("campaign_id") @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  amountPaise         BigInt        @map("amount_paise")
  gatewayFeePaise     BigInt        @default(0) @map("gateway_fee_paise")
  currency            String        @default("INR")
  gateway             String
  gatewayOrderId      String?       @map("gateway_order_id")
  gatewayPaymentId    String?       @map("gateway_payment_id")
  gatewaySignature    String?       @map("gateway_signature")
  method              String?
  status              PaymentStatus @default(CREATED)
  idempotencyKey      String?       @unique @map("idempotency_key")
  capturedAt          DateTime?     @map("captured_at")
  signatureVerifiedAt DateTime?     @map("signature_verified_at")
  orderExpiresAt      DateTime?     @map("order_expires_at")
  rawResponse         Json?         @map("raw_response")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  company      User          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refunds      Refund[]
  taxDocuments TaxDocument[]

  @@index([campaignId])
  @@index([companyId])
  @@map("campaign_payments")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  gateway     String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([gateway, eventId])
  @@map("webhook_events")
}

