}

model PhotoFlag {
  id             String          @id @default(uuid()) @db.Uuid
  photoId        String          @map("photo_id") @db.Uuid
  flaggedById    String          @map("flagged_by_id") @db.Uuid
  flaggedByRole  Role            @map("flagged_by_role")
  reason         PhotoFlagReason
