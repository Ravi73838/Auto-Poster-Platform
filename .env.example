# Environment Configuration
# Copy this file to .env before starting the services

NODE_ENV=development

# Infrastructure / Docker
POSTGRES_USER=autoposter
POSTGRES_PASSWORD=autoposter_local_secret
POSTGRES_DB=autoposter_dev
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379

# Backend API
API_PORT=4000
DATABASE_URL=postgresql://autoposter:autoposter_local_secret@localhost:5432/autoposter_dev?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Web Application
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Mobile Application (Driver App)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
